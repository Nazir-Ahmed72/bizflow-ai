# Neon connection string, pasted as-is (postgresql://...). Use the DIRECT host (no "-pooler").
# app/config.py switches it to the psycopg 3 driver automatically.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Groq (groq.com) - only needed for live LLM runs (tests use a fake LLM)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Neon test branch for pytest (never the main DB)
TEST_DATABASE_URL=
